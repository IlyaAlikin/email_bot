# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather
# Whitelisted Telegram numeric IDs, comma-separated (узнать свой: написать @userinfobot)
ADMIN_IDS=111111111,222222222

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Yandex SMTP ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=you@yandex.ru
# Пароль приложения, не обычный пароль от почты!
# https://id.yandex.ru/security/app-passwords  →  «Почта»
SMTP_PASSWORD=app-password-here
SMTP_FROM_NAME=Форвард-С

# --- Google Sheets ---
# Полный путь к JSON service-account ключу
GOOGLE_CREDS_FILE=./google-creds.json
# ID таблицы из URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# Имя листа (первого, обычно "Лист1" или "Sheet1")
GOOGLE_SHEET_NAME=Sheet1

# --- Sending behavior ---
# Пауза между письмами (сек) — Yandex имеет лимиты, не уменьшать ниже 1
SEND_DELAY_SECONDS=2
